# FrontDesk connector hosting
PORT=8787

# Aiven PostgreSQL / Postgres
AIVEN_DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
# PGSSL_REJECT_UNAUTHORIZED=false

# Owner approval token for protected draft/publish endpoints
FRONTDESK_EDITOR_TOKEN=replace-with-a-private-token

# Filestack image storage
FILESTACK_API_KEY=replace-with-your-filestack-api-key
